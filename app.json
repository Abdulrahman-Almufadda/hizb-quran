{
  "expo": {
    "name": "حزب",
    "slug": "hizb-quran",
    "description": "اقرأ القرآن الكريم كاملاً بخط المصحف الشريف مع الاستماع والبحث والعلامات المرجعية",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hizb",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF6ED",
    "primaryColor": "#0E5D52",
    "ios": {
      "bundleIdentifier": "com.hizbapp.quran",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.hizbapp.quran",
      "adaptiveIcon": {
        "backgroundColor": "#0E5D52",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6ED",
          "dark": {
            "backgroundColor": "#121917"
          }
        }
      ]
    ]
  }
}
